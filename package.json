{
  "name": "family-tree-diagram",
  "version": "1.0.2",
  "description": "Build an interactive family tree, timeline and map from person notes in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint . manifest.json && stylelint styles.css",
    "test": "esbuild test/*.test.ts --bundle --platform=node --log-level=warning --alias:obsidian=./test/obsidian-mock.ts --outdir=.test && node --test .test/*.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "leaflet": "^1.9.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "author": "Victor Mosin",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicmosin/obsidian-family-tree-diagramm"
  }
}
